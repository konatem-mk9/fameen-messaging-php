{
    "name": "fameen/messaging",
    "description": "SDK PHP officiel de l'API Fameen Messaging (SMS, WhatsApp, Email) — zéro dépendance, avec pont Laravel intégré.",
    "version": "0.1.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "fameen",
        "messaging",
        "sms",
        "whatsapp",
        "email",
        "notifications",
        "laravel"
    ],
    "homepage": "https://business.fameengroupe.com",
    "authors": [
        {
            "name": "Fameen Groupe",
            "homepage": "https://business.fameengroupe.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "illuminate/support": "Active le ServiceProvider et la facade Laravel fournis dans Fameen\\Messaging\\Laravel (^9.0|^10.0|^11.0|^12.0)."
    },
    "autoload": {
        "psr-4": {
            "Fameen\\Messaging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fameen\\Messaging\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fameen\\Messaging\\Laravel\\FameenServiceProvider"
            ],
            "aliases": {
                "Fameen": "Fameen\\Messaging\\Laravel\\Fameen"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
